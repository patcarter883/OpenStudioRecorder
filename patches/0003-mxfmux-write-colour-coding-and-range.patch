+/* The limited-range reference levels, in the form ffmpeg's MXF writer expresses them. Note the
+ * two shift bases, which is how that writer states them and why the terms are not scaled from a
+ * single anchor: black and colour are counted in 16-step units (stated at depth 4), the white
+ * anchor in whole code values (stated at depth 8). Reproduced rather than re-derived because the
+ * forms agree with its output at 8 and 10 bits - 16/235/225 and 64/940/897 - measured from files
+ * it wrote, and a single-anchor "cleanup" produced 57 where 897 was required. */
+#define VC3_ANCHOR_DEPTH 8          /* depth the white anchor is stated at */
+#define VC3_UNIT_DEPTH 4            /* depth the 16-step levels are stated at */
+#define VC3_LIMITED_BLACK_UNIT 1    /* black: 16 divided by 16 */
+#define VC3_LIMITED_WHITE_ANCHOR 235
+#define VC3_LIMITED_COLOR_UNIT 14   /* colour: 224 divided by 16; the +1 is ffmpeg's offset */
+
 static void
 mxf_vc3_update_descriptor (MXFMetadataFileDescriptor * d, GstCaps * caps,
     gpointer mapping_data, GstBuffer * buf)
 {
-  return;
+  /* Write the colour coding items and the range reference levels from the caps. The caps only
+   * carry a colorimetry at buffer time, not at descriptor creation, which is why this happens
+   * here and not in from_caps (measured: an identical-looking from_caps wrote nothing).
+   *
+   * No level is a literal: the range anchors are named once above and scaled to the essence's
+   * own component depth, which the mux set from its property. The forms are ffmpeg's, and they
+   * match its output at 8 and 10 bits, limited and full, measured from files it wrote.
+   */
+  const gchar *colorimetry;
+  GstVideoColorimetry cinfo;
+  MXFMetadataGenericPictureEssenceDescriptor *self;
+  MXFMetadataCDCIPictureEssenceDescriptor *cdci;
+
+  if (!MXF_IS_METADATA_GENERIC_PICTURE_ESSENCE_DESCRIPTOR (d))
+    return;
+  if (gst_caps_get_size (caps) < 1)
+    return;
+
+  self = MXF_METADATA_GENERIC_PICTURE_ESSENCE_DESCRIPTOR (d);
+  /* The CDCI cast is explicit and checked: this build defines G_DISABLE_CAST_CHECKS, so an
+   * unchecked cast would be a silently unchecked memory access. */
+  if (!MXF_IS_METADATA_CDCI_PICTURE_ESSENCE_DESCRIPTOR (d))
+    return;
+  cdci = MXF_METADATA_CDCI_PICTURE_ESSENCE_DESCRIPTOR (d);
+
+  if (!mxf_ul_is_zero (&self->coding_equations))
+    return;
+
+  colorimetry =
+      gst_structure_get_string (gst_caps_get_structure (caps, 0), "colorimetry");
+  if (!colorimetry || !gst_video_colorimetry_from_string (&cinfo, colorimetry)) {
+    /* No declaration: write no colour items and claim no range, so the file says nothing
+     * rather than something wrong. 0 is this descriptor class's own "not written" value. */
+    cdci->black_ref_level = 0;
+    cdci->white_ref_level = 0;
+    cdci->color_range = 0;
+    return;
+  }
+
+  switch (cinfo.matrix) {
+    case GST_VIDEO_COLOR_MATRIX_BT709:
+      memcpy (&self->coding_equations, MXF_UL (CODING_EQUATIONS_BT709), 16);
+      break;
+    case GST_VIDEO_COLOR_MATRIX_BT601:
+      memcpy (&self->coding_equations, MXF_UL (CODING_EQUATIONS_BT601), 16);
+      break;
+    default:
+      break;
+  }
+
+  switch (cinfo.primaries) {
+    case GST_VIDEO_COLOR_PRIMARIES_BT709:
+      memcpy (&self->color_primaries, MXF_UL (COLOR_PRIMARIES_BT709), 16);
+      break;
+    case GST_VIDEO_COLOR_PRIMARIES_SMPTE170M:
+      memcpy (&self->color_primaries, MXF_UL (COLOR_PRIMARIES_SMPTE170M), 16);
+      break;
+    default:
+      break;
+  }
+
+  switch (cinfo.transfer) {
+    case GST_VIDEO_TRANSFER_BT709:
+      memcpy (&self->transfer_characteristic,
+          MXF_UL (TRANSFER_CHARACTERISTIC_BT709), 16);
+      break;
+    case GST_VIDEO_TRANSFER_BT601:
+      memcpy (&self->transfer_characteristic,
+          MXF_UL (TRANSFER_CHARACTERISTIC_BT601), 16);
+      break;
+    default:
+      break;
+  }
+
+  /* The levels below shift by (depth - anchor), so an unset depth must never reach them: a
+   * negative shift is undefined and produced color-range = 0x0E000001 in a file before this
+   * guard existed. The property's own range bounds the top end. */
+  if (cdci->component_depth < VC3_ANCHOR_DEPTH) {
+    cdci->black_ref_level = 0;
+    cdci->white_ref_level = 0;
+    cdci->color_range = 0;
+    return;
+  }
+
+  switch (cinfo.range) {
+    case GST_VIDEO_COLOR_RANGE_0_255:      /* full */
+      cdci->black_ref_level = 0;
+      cdci->white_ref_level = (1 << cdci->component_depth) - 1;
+      cdci->color_range = 1 << cdci->component_depth;
+      break;
+    case GST_VIDEO_COLOR_RANGE_16_235:     /* limited: the anchors scaled to this depth */
+      cdci->black_ref_level =
+          VC3_LIMITED_BLACK_UNIT << (cdci->component_depth - VC3_UNIT_DEPTH);
+      cdci->white_ref_level =
+          VC3_LIMITED_WHITE_ANCHOR << (cdci->component_depth - VC3_ANCHOR_DEPTH);
+      cdci->color_range =
+          (VC3_LIMITED_COLOR_UNIT << (cdci->component_depth - VC3_UNIT_DEPTH)) + 1;
+      break;
+    default:                               /* unknown: claim nothing */
+      cdci->black_ref_level = 0;
+      cdci->white_ref_level = 0;
+      cdci->color_range = 0;
+      break;
+  }
 }
 
